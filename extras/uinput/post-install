#!/bin/sh
# Install the module built by scripts/build/build_extras.sh, then load it.
set -eu
D=$(cd "$(dirname "$0")" && pwd)
K=$(uname -r)
SRC=$D/../../dist/extras/$K
[ -f "$SRC/SHA256SUMS" ] || { echo "no modules for kernel $K in dist/extras: run scripts/build/build_extras.sh" >&2; exit 1; }
(cd "$SRC" && sha256sum -c --quiet SHA256SUMS) || { echo "dist/extras/$K: checksum mismatch" >&2; exit 1; }
install -d "/lib/modules/$K/extra/s9p-input"
install -m644 "$SRC"/input/uinput.ko "/lib/modules/$K/extra/s9p-input/"
mkdir -p /var/lib/s9p-extras && touch /var/lib/s9p-extras/uinput
depmod -a "$K"
[ -n "${NO_START:-}" ] || { modprobe uinput && udevadm trigger --action=change --name-match=uinput || true; }
