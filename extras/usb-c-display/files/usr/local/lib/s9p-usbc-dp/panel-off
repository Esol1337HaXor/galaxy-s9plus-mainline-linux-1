#!/bin/sh
# Force the internal panel's connector to "disconnected" before GDM starts, so
# that GNOME only uses the USB-C monitor (the panel may be broken; without a
# monitor the phone runs headless). Every DRM connector that is not ours.
for i in $(seq 1 20); do
	n=0
	for c in /sys/class/drm/card*-*; do
		[ -e "$c/status" ] || continue
		drv=$(basename "$(readlink -f "$c/../device/driver")")
		[ "$drv" = s9p-dp ] && continue
		echo off > "$c/status" && echo "s9p-panel-off: $(basename "$c") off"
		n=$((n + 1))
	done
	[ $n -gt 0 ] && exit 0
	sleep 0.5
done
echo "s9p-panel-off: no panel connector found"
