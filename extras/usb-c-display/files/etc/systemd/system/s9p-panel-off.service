[Unit]
Description=Galaxy S9+: internal panel off (USB-C monitor only)
After=systemd-udev-settle.service systemd-modules-load.service
Before=gdm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/s9p-usbc-dp/panel-off
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
