#!/bin/sh
# Remove the modules; the shared ones only if no other extra uses them.
K=$(uname -r)
modprobe -r leds-max77705 s9p-leds 2>/dev/null || true
rm -rf "/lib/modules/$K/extra/s9p-leds" /var/lib/s9p-extras/notification-led
ls /var/lib/s9p-extras/* >/dev/null 2>&1 || rm -rf "/lib/modules/$K/extra/s9p-common"
depmod -a "$K"
