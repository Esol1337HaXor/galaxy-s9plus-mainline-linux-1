[Unit]
Description=Galaxy S9+ modem: Android container with Samsung's rild
Requires=s9p-modem.service
After=s9p-modem.service

[Service]
# PID 1 of the namespace is Android's init; stopping the unit kills the whole
# cgroup, so nothing of it outlives the service
ExecStart=/usr/bin/unshare --pid --fork --mount --propagation private /usr/local/lib/s9p-modem/android
Restart=on-failure
RestartSec=10
# Android's init drops every SIGTERM sent from outside its namespace, so the
# default stop waited the full 90 s for SIGKILL on every shutdown and reboot.
# The rest of the cgroup gets SIGTERM and 5 s; the CP keeps running anyway.
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
