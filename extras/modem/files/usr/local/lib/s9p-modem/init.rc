# Android init for extras/modem: the property service (init itself), the
# service managers, logd, the suspend HAL (wakelocks) and Samsung's rild.
# Every Android service gets the SELinux shim (s9p-noselinux.c): Ubuntu's
# kernel has no SELinux, and Android refuses to work without it.
on early-init
    mkdir /dev/socket 0755 root root
    # libsec-ril takes its log level from here (androidboot.debug_level,
    # /etc/default/s9p-modem)
    setprop ro.vendor.boot.debug_level ${ro.boot.debug_level}

    # What Android's telephony sets on a dual-SIM Samsung: the slot carrying
    # data and calls. Without it libsec-ril ignores the PS registration
    # ("DDS not match") and rejects every data call.
    setprop ril.dds.data.slotid 0
    setprop ril.dds.datacross.slotid 0
    setprop ril.dds.call.slotid 0

on late-init
    mkdir /data/vendor 0771 root system
    mkdir /data/vendor/radio 0771 radio radio
    mkdir /data/vendor/log 0771 root system
    mkdir /data/vendor/log/cbd 0771 radio radio
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/radio 0770 system radio
    start logd
    start servicemanager
    start hwservicemanager
    start vndservicemanager
    start system_suspend
    start ril-daemon

service servicemanager /system/bin/servicemanager
    user system
    group system readproc
    setenv LD_PRELOAD /system/lib64/s9p-noselinux.so

service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    setenv LD_PRELOAD /system/lib64/s9p-noselinux.so

service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
    user system
    group system readproc
    setenv LD_PRELOAD /vendor/lib64/s9p-noselinux.so

service ril-daemon /vendor/bin/hw/rild -l ${vendor.sec.rild.libpath}
    user radio
    group radio cache inet misc audio sdcard_r sdcard_rw log vpn system readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW SYS_ADMIN CHOWN SYS_TIME
    setenv LD_PRELOAD /vendor/lib64/s9p-noselinux.so

service logd /system/bin/logd
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram+passcred 0222 logd logd
    file /proc/kmsg r
    file /dev/kmsg w
    user logd
    group logd system package_info readproc
    capabilities SYSLOG AUDIT_CONTROL SETGID
    setenv LD_PRELOAD /system/lib64/s9p-noselinux.so

# wakelocks for the RIL; /sys/power is a fake in this container and
# autosuspend is never enabled (that is system_server's call)
service system_suspend /system/bin/hw/android.system.suspend@1.0-service
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    setenv LD_PRELOAD /system/lib64/s9p-noselinux.so
