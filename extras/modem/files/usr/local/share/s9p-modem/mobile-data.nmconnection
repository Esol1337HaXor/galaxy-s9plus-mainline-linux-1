# NetworkManager's mobile data connection, installed once (mode 600) by
# extras/modem/post-install. The APN comes from mobile-broadband-provider-info
# by the SIM's operator (auto-config); Settings > Mobile Network can set
# another. Roaming is off, as on a phone; data stays behind Wi-Fi (route
# metric 700 against Wi-Fi's 600).
[connection]
id=Mobile data
uuid=5e9f7d1c-2b8a-4c3e-9d6f-1a2b3c4d5e6f
type=gsm
autoconnect=true

[gsm]
auto-config=true
home-only=true

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto
