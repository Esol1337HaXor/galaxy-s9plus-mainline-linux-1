#!/bin/sh
# A command inside the modem's Android container (getprop, setprop...):
#   s9p-android-sh getprop ril.dds.data.slotid
P=$(systemctl show -p MainPID --value s9p-android.service)
[ "${P:-0}" != 0 ] || { echo "s9p-android.service is not running" >&2; exit 1; }
I=$(pgrep -P "$P" -x init | head -1)
[ -n "$I" ] || { echo "no Android init in s9p-android.service" >&2; exit 1; }
exec nsenter -t "$I" -m -p /usr/sbin/chroot /run/s9p-modem/android /system/bin/env \
	PATH=/system/bin:/vendor/bin "$@"
