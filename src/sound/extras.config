# Kernel options for the USB-C and audio extras, on top of the stable kernel
# configuration (scripts/build/build_stable.sh). Everything is a module or a
# bool inside one: the installed kernel image does not change, so the modules
# load into it. Applied by scripts/build/build_extras.sh to a copy of out/.config.
#
# HID (keyboards, mice and receivers on the USB-C hub)
CONFIG_HID_SUPPORT=y
CONFIG_HID=m
CONFIG_HIDRAW=y
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_HID_APPLE=m
CONFIG_HID_CHERRY=m
CONFIG_HID_KENSINGTON=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MULTITOUCH=m
# ALSA, ASoC, USB audio
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_ALOOP=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_HDMI_CODEC=m
# Cirrus Logic CS47L93 (madera; the cs47l92 driver covers it)
CONFIG_MFD_MADERA=m
CONFIG_MFD_MADERA_SPI=m
CONFIG_MFD_CS47L92=y
CONFIG_PINCTRL_MADERA=m
CONFIG_GPIO_MADERA=m
CONFIG_REGULATOR_ARIZONA_LDO1=m
CONFIG_REGULATOR_ARIZONA_MICSUPP=m
# hidden upstream; build_extras.sh gives it a prompt in the build tree
CONFIG_SND_SOC_CS47L92=m
