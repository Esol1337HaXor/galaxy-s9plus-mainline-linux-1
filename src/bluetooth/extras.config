# Kernel options for the Bluetooth extra (BCM4361 on UART1), applied by
# scripts/build/build_extras.sh on top of the stable configuration.
# RFKILL must stay off: CFG80211 (built in) depends on "RFKILL || !RFKILL",
# and RFKILL=m would turn it into a module.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=m
