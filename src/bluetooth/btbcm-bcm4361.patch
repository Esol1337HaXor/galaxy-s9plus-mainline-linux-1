btbcm: BCM4361B2 on the Galaxy S9+ (star2lte)

- 43:61:B2:00:1F:AC is the address every BCM4361B2 boots with: mark it
  invalid, so hci_bcm takes "local-bd-address" (s9p-bt-board puts the
  phone's own address from EFS there).
- The controller advertises LE Read Transmit Power but fails it, which
  aborts the init: set HCI_QUIRK_BROKEN_READ_TRANSMIT_POWER on this board.

--- a/drivers/bluetooth/btbcm.c	2026-10-14 19:43:28.706028003 +0000
+++ b/drivers/bluetooth/btbcm.c	2026-10-14 19:43:28.707028003 +0000
@@ -31,6 +31,7 @@
 #define BDADDR_BCM4334B0 (&(bdaddr_t) {{0x00, 0x00, 0x00, 0xb0, 0x34, 0x43}})
 #define BDADDR_BCM4345C5 (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0xc5, 0x45, 0x43}})
 #define BDADDR_BCM43341B (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0x1b, 0x34, 0x43}})
+#define BDADDR_BCM4361B2 (&(bdaddr_t) {{0xac, 0x1f, 0x00, 0xb2, 0x61, 0x43}})
 
 #define BCM_FW_NAME_LEN			64
 #define BCM_FW_NAME_COUNT_MAX		4
@@ -130,7 +131,8 @@
 	    !bacmp(&bda->bdaddr, BDADDR_BCM4345C5) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM43430A0) ||
 	    !bacmp(&bda->bdaddr, BDADDR_BCM43430A1) ||
-	    !bacmp(&bda->bdaddr, BDADDR_BCM43341B)) {
+	    !bacmp(&bda->bdaddr, BDADDR_BCM43341B) ||
+	    !bacmp(&bda->bdaddr, BDADDR_BCM4361B2)) {
 		/* Try falling back to BDADDR EFI variable */
 		if (btbcm_set_bdaddr_from_efi(hdev) != 0) {
 			bt_dev_info(hdev, "BCM: Using default device address (%pMR)",
@@ -464,7 +466,8 @@
 	kfree_skb(skb);
 
 	/* Read DMI and disable broken Read LE Min/Max Tx Power */
-	if (dmi_first_match(disable_broken_read_transmit_power))
+	if (dmi_first_match(disable_broken_read_transmit_power) ||
+	    of_machine_is_compatible("samsung,star2lte"))
 		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_READ_TRANSMIT_POWER);
 
 	return 0;
