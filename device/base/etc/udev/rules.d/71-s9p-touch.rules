# S9+ Touch-Mapping (Ubuntu 24.04 / GNOME Wayland, mutter 46.2)
#
# 1) Internes Touch (s6sy761, i2c 0-0048): der Treiber meldet beim Boot oft
#    keine gueltigen Achsen (erster probe -110 ETIMEDOUT; die s9p-acpm
#    LDO-Cycle-Reprobe legt das Input-Device ohne Achsen an: "the axis have
#    not been set"). Ohne Override bekommt libinput Muell-Ranges -> Touch tot.
#    Die Firmware meldet 12-bit-Koordinaten (DT: touchscreen-size-x/y = <4096>)
#    -> Override 0:4095 auf beiden Achsen (ABS_MT_POSITION_X/Y = 0x35/0x36).
#    ACHTUNG: NICHT 0:1439/0:2959 (Panel-Groesse) nehmen — die Firmware meldet
#    12-bit-Werte, mit Panel-Groesse landet jeder Tap am Rand.
ACTION=="add", SUBSYSTEM=="input", ATTRS{name}=="s6sy761", ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1", ENV{ID_INPUT_TOUCHPAD}="", ENV{ID_INPUT_MOUSE}=""
ACTION=="add", KERNEL=="event*", ATTRS{name}=="s6sy761", ENV{EVDEV_ABS_35}="0:4095", ENV{EVDEV_ABS_36}="0:4095", ENV{EVDEV_ABS_00}="0:4095", ENV{EVDEV_ABS_01}="0:4095"

# 2) Externes Touch (wch.cn TouchScreen, USB 27c0:0859): das zweite
#    HID-Interface ist eine Fake-Maus (ID_INPUT_MOUSE=1, libinput
#    Capabilities: pointer) und bewegt den Cursor ohne Monitor-Mapping ->
#    von libinput ignorieren; das Multitouch-Interface (ID_INPUT_TOUCHSCREEN=1)
#    ist das echte Touch-Device.
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{name}=="wch.cn TouchScreen", ENV{ID_INPUT_MOUSE}=="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"

# 3) USB-Autosuspend fuer das Touch-Display aus (beobachtet: haueufige
#    Re-Enumerations des Devices am Hub).
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="27c0", ATTRS{idProduct}=="0859", ATTR{power/control}="on"

# 4) Externes Touch -> externer Monitor (DP-1, RTK ANMITE): das Mapping laeuft
#    in mutter 46 ueber den gsettings-Key "output" im per-device Schema
#    org.gnome.desktop.peripherals.touchscreen, Pfad
#    /org/gnome/desktop/peripherals/touchscreens/27c0:0859/
#    (vendor/product = "%.4x" der libinput-IDs), Wert = EDID des Monitors:
#      dconf write '/org/gnome/desktop/peripherals/touchscreens/27c0:0859/output' \
#        "['RTK', 'ANMITE', '0x19201200']"
